# =====================================================================
# CareerPilot AI — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is already git-ignored — never commit real keys.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase
# Project Settings → API in your Supabase dashboard.
# ---------------------------------------------------------------------

# Project URL. Safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# "anon" / "public" key. Safe to expose to the browser — RLS policies
# (see docs/schema.sql) are what actually protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# "service_role" key. SECRET — bypasses Row Level Security entirely.
# Server-only. Must NEVER be prefixed with NEXT_PUBLIC_ or referenced
# from a Client Component. Used by src/lib/supabase/admin.ts for
# trusted backend/agent writes (e.g. Job Hunter populating job_listings).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------
# OpenRouter (LLM calls)
# https://openrouter.ai/keys
# ---------------------------------------------------------------------

# SECRET — server-only, used by lib/ai/openrouter.ts.
OPENROUTER_API_KEY=your-openrouter-api-key

# Default model for every OpenRouter call in the app (resume parsing now,
# Resume Architect / Interview Agent later). Override per-call if a
# feature ever needs a different model.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---------------------------------------------------------------------
# Google OAuth (Email Agent — Gmail integration)
# Google Cloud Console → APIs & Services → Credentials → Create
# OAuth client ID (Web application). Add GOOGLE_REDIRECT_URI below as
# an Authorized redirect URI there, and enable the Gmail API under
# APIs & Services → Library. This app requests sensitive scopes
# (gmail.send, gmail.modify), so while the OAuth consent screen is in
# "Testing" mode (the default until you submit for verification), add
# your own Google account as a test user under OAuth consent screen →
# Test users, or Google will refuse to complete the flow for it.
# ---------------------------------------------------------------------

# SECRET — server-only, used by lib/gmail.ts.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Must exactly match an Authorized redirect URI on the OAuth client
# above (including the port). Update for production deploys.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# SECRET — 32-byte key (as base64 or 64-char hex) used to encrypt Gmail
# access/refresh tokens at rest in oauth_tokens (see lib/crypto.ts).
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=your_32_byte_encryption_key

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------

# Base URL of this app. Used for auth redirect/callback URLs and any
# absolute links generated in emails. Update for production deploys.
NEXT_PUBLIC_APP_URL=http://localhost:3000
